# Hindsight Cloud (https://ui.hindsight.vectorize.io) or a self-hosted server
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=hsk_your_key_here
HINDSIGHT_BANK_ID=why-org-decisions

# Any OpenAI-compatible endpoint. Results in evaluation/results were produced on Cerebras gpt-oss-120b.
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=gpt-oss-120b
LLM_API_KEY=your_key_here
# Groq instead:  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b
# Optional client-side pacing for batch scripts on free tiers (requests per minute; 0 = off)
LLM_RPM=0
